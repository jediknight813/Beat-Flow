 "loop": [
  "1. Once per song: memory = encoder(features, section_label, difficulty, song_pad); mem_* = cross_kv(memory); cands, keys = candidates(memory, cand_feats, cand_tokens).",
  "2. Init: position = 0; past_* = empty [1,H,0,E]; prev_idx = 0; prev_time = 0; last[hand] = none; history empty.",
  "3. Per step: build prev_tokens from the last placed swing (raw values of prev_token_fields: hand, gap, parity, cut, dot, cell, stack, chain, chain_slices, chain_tail, arc_out, follow), prev_cand_repr = cands[last cand], state_tokens from last[0] / last[1] with gap_bucket(prev_time - last.time) + 1; at position 0 these are ignored (pass zeros).",
  "4. h, hand_logits, present_* = step(...); past_* = present_*; position += 1 (after the step).",
  "5. Sample hand from hand_logits (mask END unless prev_time >= min_end_fraction * duration); END stops the loop.",
  "6. follow_logits = follow(h, hand); sample follow (apply focus_stick / intro rules client-side).",
  "7. mine_tokens, same_time, same_ok from last[hand]; keys_window / times_window / valid from prev_idx; pointer_logits = pointer(...); apply window_mask / literalness rules; sample w; cand = prev_idx + w; now = cand_times[cand].",
  "8. gesture logits = gesture(h, hand, follow, mine_tokens, now, same_time, same_ok, cands[cand]); sample parity, cut, dot, cell, stack, chain, chain_slices, chain_tail, arc_out with the client-side masks.",
  "9. Place the swing: history gap = gap_bucket(now - prev_time); prev_idx = cand; prev_time = now; last[hand] = this swing (cell, cut, parity, time)."
 ],
